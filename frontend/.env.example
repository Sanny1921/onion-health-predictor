# Configurable Backend URL for Node.js API Service
# For local dev on same machine: http://localhost:8000
# For physical mobile device testing: http://<PC_LOCAL_IP>:8000 (e.g. http://192.168.1.50:8000)
VITE_BACKEND_URL="http://localhost:8000"

# Note: GEMINI_API_KEY must NEVER be configured in frontend.
# All vision analysis calls are routed securely through the Node.js backend.
